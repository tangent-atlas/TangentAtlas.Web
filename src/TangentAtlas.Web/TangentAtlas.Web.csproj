<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!--
      The signed-in pages read a Replica of the person's tenants, generated here exactly as the ledger server generates its
      Primary: the Bellerophon package, the ledger's model (the AtlasLedger.Model package), and the role.  The website and
      the ledger therefore move to a new model together.
    -->
    <BellerophonRole>Replica</BellerophonRole>
  </PropertyGroup>

  <ItemGroup>
    <!-- The generator, at build time only: nothing of it ships, and projects that reference this one (the tests) do not run it. -->
    <PackageReference Include="Bellerophon" Version="0.5.0" PrivateAssets="all" />
    <PackageReference Include="AtlasLedger.Model" Version="1.1.0-preview.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
    <!-- Microsoft.Identity.Web brings 10.0.10, which has advisories GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
