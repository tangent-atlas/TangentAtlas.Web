<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content="Tangent Atlas: a thermostat for all your money" />
    <meta property="og:description" content="Connect your bank, brokerage and credit cards, set your rules, and respond with discipline, not panic." />
    <meta name="description" content="Connect your bank, brokerage and credit cards, set your rules, and respond with discipline, not panic." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@300;400;500&display=swap" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["TangentAtlas.Web.styles.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" ContentsView="ContentsViews.From(HttpContext)" />
    <ReconnectModal />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/tree.js"></script>
    <script src="@Assets["js/preview.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // The signed-in pages run interactively, frame and all, so everything on them that comes from the ledger (an
    // account's name in the title bar as much as its holdings) is part of the live view model.  The public pages are
    // static: Pages/Public's [ExcludeFromInteractiveRouting].
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
