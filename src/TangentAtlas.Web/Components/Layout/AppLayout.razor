@inherits LayoutComponentBase
@* The signed-in frame: a rail of the application's functions on the left, which expands to show their names (the
   Blazor template's NavMenu toggler: a checkbox and its label, no script), and a top bar with the page's title and the
   person's menu.  The pages that explain the product use MainLayout instead. *@

<div class="ta-app">
    <input type="checkbox" id="ta-rail-toggle" class="ta-rail-toggle" aria-label="Show the menu's names" />
    <nav class="ta-rail" aria-label="Application">
        <label for="ta-rail-toggle" class="ta-rail-brand" title="Expand or collapse the menu">
            <img src="images/logo-mark.png" alt="" class="ta-rail-mark" />
            <span class="ta-rail-text ta-rail-wordmark">Tangent <span class="ta-logo-accent">Atlas</span></span>
        </label>
        <NavLink href="dashboard" class="ta-rail-link" Match="NavLinkMatch.All" title="Dashboard">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5" /><rect x="13.5" y="3.5" width="7" height="7" rx="1.5" /><rect x="3.5" y="13.5" width="7" height="7" rx="1.5" /><rect x="13.5" y="13.5" width="7" height="7" rx="1.5" /></svg>
            <span class="ta-rail-text">Dashboard</span>
        </NavLink>
        <NavLink href="investments" class="ta-rail-link" Match="NavLinkMatch.Prefix" title="Investments">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h16" /><rect x="5.5" y="12" width="3" height="6" rx="0.5" /><rect x="10.5" y="8" width="3" height="10" rx="0.5" /><rect x="15.5" y="4" width="3" height="14" rx="0.5" /></svg>
            <span class="ta-rail-text">Investments</span>
        </NavLink>
    </nav>
    <label for="ta-rail-toggle" class="ta-rail-scrim" aria-hidden="true"></label>

    <div class="ta-app-body">
        <header class="ta-app-bar">
            <label for="ta-rail-toggle" class="ta-app-menu" title="Menu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                <span class="ta-visually-hidden">Menu</span>
            </label>
            <div class="ta-app-title"><SectionOutlet SectionName="app-title" /></div>
            <AuthorizeView>
                <Authorized>
                    @{ var person = SignedInPerson.From(context.User); }
                    <details class="ta-app-person">
                        <summary title="@person?.DisplayName">@Initials(person?.DisplayName)</summary>
                        <div class="ta-app-person-menu">
                            <div class="ta-app-person-name">@person?.DisplayName</div>
                            @if (person?.Email is { } email && email != person.DisplayName)
                            {
                                <div class="ta-app-person-email">@email</div>
                            }
                            <a href="/">Tangent Atlas home page</a>
                            <form method="post" action="/account/signout">
                                <AntiforgeryToken />
                                <button type="submit">Sign out</button>
                            </form>
                        </div>
                    </details>
                </Authorized>
            </AuthorizeView>
        </header>
        <main class="ta-app-main">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static string Initials(string? name)
    {
        var words = (name ?? "").Split([' ', '@', '.'], StringSplitOptions.RemoveEmptyEntries);
        return words.Length switch
        {
            0 => "?",
            1 => words[0][..1].ToUpperInvariant(),
            _ => (words[0][..1] + words[1][..1]).ToUpperInvariant(),
        };
    }
}
