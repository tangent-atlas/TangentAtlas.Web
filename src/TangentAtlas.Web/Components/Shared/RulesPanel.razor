@* An example of the rules a customer sets: the landing page's illustration, and the empty state of the signed-in page. *@
<figure class="ta-rules">
    <div class="ta-eyebrow ta-eyebrow-muted">@Heading</div>

    <div class="ta-rules-dial">
        <svg width="148" height="148" viewBox="0 0 148 148" role="img" aria-label="A thermostat dial for checking, set between $5,000 and $10,000">
            <circle cx="74" cy="74" r="58" fill="none" stroke="#e5e7eb" stroke-width="12" stroke-linecap="round" stroke-dasharray="273.3 364.4" transform="rotate(135 74 74)"></circle>
            <circle cx="74" cy="74" r="58" fill="none" stroke="#1D9E75" stroke-width="12" stroke-linecap="round" stroke-dasharray="91.1 364.4" stroke-dashoffset="-91.1" transform="rotate(135 74 74)"></circle>
            <circle cx="74" cy="74" r="44" fill="#ffffff" stroke="rgba(0,0,0,0.08)" stroke-width="1"></circle>
            <text x="74" y="70" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="12" fill="#4b5563">Checking</text>
            <text x="74" y="88" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="13" font-weight="500" fill="#1a1a1a">$5k – $10k</text>
        </svg>
        <div class="ta-rules-dial-text">
            <div class="ta-rules-dial-title">Keep checking between $5,000 and $10,000</div>
            <div class="ta-rules-dial-sub">Above the range, the surplus goes where your other rules say. Below it, checking is topped up first.</div>
        </div>
    </div>

    <ul class="ta-rules-list">
        <li>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F6E56" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2"></rect><line x1="2.5" y1="10" x2="21.5" y2="10"></line><line x1="6" y1="15" x2="10" y2="15"></line></svg>
            <span>Make sure every card is paid in full</span>
        </li>
        <li>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F6E56" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"></path><polyline points="8.5 12 11 14.5 15.5 10"></polyline></svg>
            <span>Max out your IRA</span>
        </li>
        <li>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F6E56" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 17 9 11 13 15 21 7"></polyline><polyline points="15 7 21 7 21 13"></polyline></svg>
            <span>Invest the rest in your favorite stocks</span>
        </li>
    </ul>
    <figcaption class="ta-rules-caption">You choose the rules and the order they run in.</figcaption>
</figure>

@code {
    [Parameter] public string Heading { get; set; } = "Example: your rules";
}
