@* An example of the rules a customer sets: the landing page's illustration, and the empty state of the signed-in page.
   Every rule gets the same dial, so they read as a set of equally important rules, in the order they run. *@
<figure class="ta-rules">
    <div class="ta-eyebrow ta-eyebrow-muted">@Heading</div>

    <ol class="ta-rules-list">
        @foreach (var rule in Rules)
        {
            <li class="ta-rule">
                <svg class="ta-rule-dial" width="96" height="96" viewBox="0 0 100 100" role="img" aria-label="@rule.Description">
                    <circle cx="50" cy="50" r="40" fill="none" stroke="#e5e7eb" stroke-width="8" stroke-linecap="round" stroke-dasharray="@N(Track) @N(Circumference)" transform="rotate(135 50 50)"></circle>
                    <circle cx="50" cy="50" r="40" fill="none" stroke="#1D9E75" stroke-width="8" stroke-linecap="round" stroke-dasharray="@N(Arc(rule.To - rule.From)) @N(Circumference)" stroke-dashoffset="@N(-Arc(rule.From))" transform="rotate(135 50 50)"></circle>
                    <circle cx="50" cy="50" r="30" fill="#ffffff" stroke="rgba(0,0,0,0.08)" stroke-width="1"></circle>
                    <text x="50" y="46" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="10.5" fill="#4b5563">@rule.Label</text>
                    <text x="50" y="61.5" text-anchor="middle" font-family="DM Sans, sans-serif" font-size="12" font-weight="500" fill="#1a1a1a">@rule.Setting</text>
                </svg>
                <div class="ta-rule-text">
                    <div class="ta-rule-title">@rule.Title</div>
                    <div class="ta-rule-sub">@rule.Order</div>
                </div>
            </li>
        }
    </ol>
    <figcaption class="ta-rules-caption">You choose the rules and the order they run in.</figcaption>
</figure>

@code {
    [Parameter] public string Heading { get; set; } = "Example: your rules";

    // The dial's track is three quarters of a circle; From and To are the green part, as fractions of the track.
    private const double Radius = 40;
    private static readonly double Circumference = Math.Round(2 * Math.PI * Radius, 1);
    private static readonly double Track = Math.Round(Circumference * 0.75, 1);

    private static double Arc(double fraction) => Math.Round(Track * fraction, 1);

    private static string N(double value) => (value + 0.0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);   // + 0.0 turns −0 into 0

    private sealed record Rule(string Label, string Setting, double From, double To, string Title, string Order, string Description);

    private static readonly Rule[] Rules =
    [
        new("Checking", "$5k–$10k", 1.0 / 3, 2.0 / 3, "Keep checking between $5,000 and $10,000", "Checking gets topped off first.", "A dial for checking, set between $5,000 and $10,000"),
        new("Cards", "In full", 0, 1, "Make sure every card is paid in full", "Then every card, before it’s due.", "A dial for credit cards, set to paid in full"),
        new("IRA", "Maxed", 0, 1, "Max out your IRA", "Then your IRA, up to the yearly limit.", "A dial for the IRA, set to the yearly maximum"),
        new("Stocks", "The rest", 0, 1, "Invest the rest in your favorite stocks", "Whatever is left goes to work.", "A dial for stocks, set to invest the rest"),
    ];
}
