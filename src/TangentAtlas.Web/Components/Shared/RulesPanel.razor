@* An example of the rules a customer sets: the landing page's illustration, and the empty state of the signed-in page.
   Every rule has the same size and layout, so they read as rules applied one after another to the customer's money. *@
<figure class="ta-rules">
    <div class="ta-eyebrow ta-eyebrow-muted">@Heading</div>

    <ol class="ta-rules-list">
        <li class="ta-rule">
            <span class="ta-rule-graphic">
                @* A gauge for checking, $0 to $15,000, with no text; the green band is $5,000 to $10,000 (the middle third of the track). *@
                <svg width="44" height="44" viewBox="0 0 44 44" role="img" aria-label="A gauge for checking, set between $5,000 and $10,000">
                    <circle cx="22" cy="23" r="17" fill="#ffffff" stroke="none"></circle>
                    <circle cx="22" cy="23" r="17" fill="none" stroke="#e5e7eb" stroke-width="5" stroke-linecap="round" stroke-dasharray="80.1 106.8" transform="rotate(135 22 23)"></circle>
                    <circle cx="22" cy="23" r="17" fill="none" stroke="#1D9E75" stroke-width="5" stroke-linecap="round" stroke-dasharray="26.7 106.8" stroke-dashoffset="-26.7" transform="rotate(135 22 23)"></circle>
                </svg>
            </span>
            <span class="ta-rule-text">
                <span class="ta-rule-title">Keep checking between $5,000 and $10,000</span>
                <span class="ta-rule-sub">Checking gets topped off first.</span>
            </span>
        </li>
        <li class="ta-rule">
            <span class="ta-rule-graphic">
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#0F6E56" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2"></rect><line x1="2.5" y1="10" x2="21.5" y2="10"></line><line x1="6" y1="15" x2="10" y2="15"></line></svg>
            </span>
            <span class="ta-rule-text">
                <span class="ta-rule-title">Pay every card in full</span>
                <span class="ta-rule-sub">Before every due date. No interest, no late fees.</span>
            </span>
        </li>
        <li class="ta-rule">
            <span class="ta-rule-graphic">
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#0F6E56" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"></path><polyline points="8.5 12 11 14.5 15.5 10"></polyline></svg>
            </span>
            <span class="ta-rule-text">
                <span class="ta-rule-title">Max out your IRA</span>
                <span class="ta-rule-sub">Every year, before the deadline, without a second thought.</span>
            </span>
        </li>
        <li class="ta-rule">
            <span class="ta-rule-graphic">
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#0F6E56" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 17 9 11 13 15 21 7"></polyline><polyline points="15 7 21 7 21 13"></polyline></svg>
            </span>
            <span class="ta-rule-text">
                <span class="ta-rule-title">Invest the rest in your favorite stocks</span>
                <span class="ta-rule-sub">Whatever is left goes to work.</span>
            </span>
        </li>
    </ol>
</figure>

@code {
    [Parameter] public string Heading { get; set; } = "Example: your rules";
}
