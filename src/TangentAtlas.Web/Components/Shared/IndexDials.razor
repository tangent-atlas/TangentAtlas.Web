@using System.Globalization
@using TangentAtlas.Web.Illustration

@* The home page's dashboard: the personal index on two dials, how many companies and how much risk.
   It starts where an index fund starts (all 500, fully invested) and marks no setting as recommended: the visitor turns
   the dials and sees what each setting means for his own money (Path A). The figures are an approximation, labelled as one. *@
<section class="ta-dials" aria-labelledby="ta-dials-title">
    <div class="ta-dials-head">
        <h2 id="ta-dials-title" class="ta-dials-title">Turn the dials</h2>
        <p class="ta-dials-sub">Start where an index fund starts: all 500 companies, fully invested. Then make it yours.</p>
    </div>

    <div class="ta-dials-controls">
        <fieldset class="ta-dial">
            <legend class="ta-dial-name">How many companies?</legend>
            <svg class="ta-dial-gauge" viewBox="0 0 140 120" role="img" aria-label="@($"{Result.CompanyCount} companies")">
                <circle cx="70" cy="66" r="52" fill="none" stroke="#e5e7eb" stroke-width="10" stroke-linecap="round" stroke-dasharray="@Arc(1.0)" transform="rotate(135 70 66)"></circle>
                <circle cx="70" cy="66" r="52" fill="none" stroke="#0F6E56" stroke-width="10" stroke-linecap="round" stroke-dasharray="@Arc(CompanyDialFraction)" transform="rotate(135 70 66)"></circle>
                <text x="70" y="70" text-anchor="middle" class="ta-dial-reading">@Result.CompanyCount</text>
                <text x="70" y="90" text-anchor="middle" class="ta-dial-unit">companies</text>
            </svg>
            <input class="ta-dial-slider" type="range" min="0" max="@(Stops.Count - 1)" step="1"
                   @bind="stopIndex" @bind:event="oninput"
                   aria-label="How many companies" aria-valuetext="@($"{Result.CompanyCount} companies")" />
            <div class="ta-dial-scale" aria-hidden="true"><span>@Stops[0]</span><span>@Stops[^1]</span></div>
            <p class="ta-dial-note">The largest US companies, weighted by size, less any you leave out.</p>
        </fieldset>

        <fieldset class="ta-dial">
            <legend class="ta-dial-name">How much risk?</legend>
            <svg class="ta-dial-gauge" viewBox="0 0 140 120" role="img" aria-label="@($"Volatility {Percent(Result.Volatility)}")">
                <circle cx="70" cy="66" r="52" fill="none" stroke="#e5e7eb" stroke-width="10" stroke-linecap="round" stroke-dasharray="@Arc(1.0)" transform="rotate(135 70 66)"></circle>
                <circle cx="70" cy="66" r="52" fill="none" stroke="#2f5f8a" stroke-width="10" stroke-linecap="round" stroke-dasharray="@Arc(RiskDialFraction)" transform="rotate(135 70 66)"></circle>
                <text x="70" y="70" text-anchor="middle" class="ta-dial-reading">@Percent(Result.Volatility)</text>
                <text x="70" y="90" text-anchor="middle" class="ta-dial-unit">volatility</text>
            </svg>

            <div class="ta-dial-options" role="radiogroup" aria-label="How to set your risk">
                <label class="ta-dial-option">
                    <input type="radio" name="ta-risk" checked="@(risk == RiskSetting.HoldSteady)" @onchange="() => risk = RiskSetting.HoldSteady" />
                    <span><b>Hold my risk steady.</b> Your cash is reset as markets get calmer or bumpier, so your risk stays near your setting.</span>
                </label>
                <label class="ta-dial-option">
                    <input type="radio" name="ta-risk" checked="@(risk == RiskSetting.FixedCash)" @onchange="() => risk = RiskSetting.FixedCash" />
                    <span><b>Keep a fixed amount in cash.</b> Your risk rises and falls with the market.</span>
                </label>
                <label class="ta-dial-option">
                    <input type="radio" name="ta-risk" checked="@(risk == RiskSetting.FullyInvested)" @onchange="() => risk = RiskSetting.FullyInvested" />
                    <span><b>Stay fully invested.</b> No cash; your risk is your index’s own.</span>
                </label>
            </div>

            @if (risk == RiskSetting.HoldSteady)
            {
                <input class="ta-dial-slider" type="range" min="@TargetMinimum" max="@TargetMaximum" step="1"
                       @bind="targetPercent" @bind:event="oninput"
                       aria-label="Volatility to hold" aria-valuetext="@($"{targetPercent}% volatility")" />
                <div class="ta-dial-scale" aria-hidden="true"><span>@(TargetMinimum)%</span><span>@(TargetMaximum)%</span></div>
                <label class="ta-dial-field">
                    <span>Or set it by the loss you could live with in a bad year: $</span>
                    <input type="number" min="0" step="1000" @bind="lossYouCouldLiveWith" @bind:event="oninput" @bind:after="SetTargetFromLoss" />
                </label>
                @if (Result.TargetAboveIndex)
                {
                    <p class="ta-dial-note">That’s more risk than these companies carry on their own, so your index stays fully invested. Holding your risk steady raises cash; it never borrows.</p>
                }
            }
            else if (risk == RiskSetting.FixedCash)
            {
                <label class="ta-dial-field">
                    <span>Cash to keep: $</span>
                    <input type="number" min="0" step="1000" @bind="cashAmount" @bind:event="oninput" />
                </label>
            }
        </fieldset>
    </div>

    <div class="ta-dials-result">
        <label class="ta-dial-field ta-dials-amount">
            <span>Your index, on $</span>
            <input type="number" min="0" step="10000" @bind="accountValue" @bind:event="oninput" />
        </label>

        <div class="ta-holdings-bar" role="img" aria-label="@BarDescription">
            @for (var i = 0; i < Result.LargestWeights.Count; i++)
            {
                <div class="ta-holdings-seg @SegmentClasses[i]" style="width: @Width(Result.LargestWeights[i])">@SegmentLabel(RankNames[i], Result.LargestWeights[i])</div>
            }
            @if (Result.OtherCompaniesWeight > 0)
            {
                <div class="ta-holdings-seg ta-holdings-rest" style="width: @Width(Result.OtherCompaniesWeight)">@SegmentLabel($"{Result.CompanyCount - Result.LargestWeights.Count} more", Result.OtherCompaniesWeight)</div>
            }
            @if (Result.CashWeight > 0)
            {
                <div class="ta-holdings-seg ta-holdings-cash" style="width: @Width(Result.CashWeight)">@SegmentLabel("Cash", Result.CashWeight)</div>
            }
        </div>

        <div class="ta-plan-stats">
            <div class="ta-plan-stat"><span>Companies</span><span class="ta-plan-value">@Result.CompanyCount</span></div>
            <div class="ta-plan-stat"><span>Largest company</span><span class="ta-plan-value">@Percent(Result.LargestWeights[0], "0.0")</span></div>
            <div class="ta-plan-stat"><span>Cash today</span><span class="ta-plan-value">@Dollars(accountValue * (decimal)Result.CashWeight)</span></div>
            <div class="ta-plan-stat"><span>Volatility</span><span class="ta-plan-value">@Percent(Result.Volatility)</span></div>
            <div class="ta-plan-stat"><span>Drop in a bad year</span><span class="ta-plan-value">@Dollars(Result.BadYearLow)–@Dollars(Result.BadYearHigh)</span></div>
        </div>
        <p class="ta-caption">An illustration, not a backtest. In past bad years, worst drops ran about two to three times the volatility. <a href="#about-the-dials">How these figures are made</a></p>
    </div>
</section>

@code {
    private const int TargetMinimum = 5, TargetMaximum = 25;
    private static readonly string[] RankNames = ["Largest", "2nd", "3rd"];
    private static readonly string[] SegmentClasses = ["ta-holdings-c1", "ta-holdings-c3", "ta-holdings-c2"];
    private static readonly double ArcLength = 2 * Math.PI * 52 * 0.75;   // a 270° dial
    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;
    private static IReadOnlyList<int> Stops => PersonalIndexIllustration.CompanyStops;

    private int stopIndex = PersonalIndexIllustration.CompanyStops.Count - 1;   // all 500: where an index fund starts
    private RiskSetting risk = RiskSetting.FullyInvested;
    private int targetPercent = 15;
    private decimal accountValue = 500_000m;
    private decimal cashAmount = 100_000m;
    private decimal? lossYouCouldLiveWith;

    private IndexIllustration Result => PersonalIndexIllustration.Illustrate(
        new DialSettings(Stops[Math.Clamp(stopIndex, 0, Stops.Count - 1)], risk, accountValue, cashAmount, targetPercent / 100.0));

    private double CompanyDialFraction => (double)stopIndex / (Stops.Count - 1);

    private double RiskDialFraction => Math.Clamp(Result.Volatility / 0.30, 0.0, 1.0);   // the gauge reads 0% to 30%

    private string BarDescription =>
        $"{Result.CompanyCount} companies: the largest {Percent(Result.LargestWeights[0], "0.0")}, cash {Percent(Result.CashWeight)}";

    private void SetTargetFromLoss()
    {
        if (lossYouCouldLiveWith is { } loss)
        {
            targetPercent = (int)Math.Round(PersonalIndexIllustration.TargetForLoss(loss, accountValue) * 100, MidpointRounding.AwayFromZero);
        }
    }

    private static string Arc(double fraction) =>
        string.Create(Invariant, $"{ArcLength * Math.Clamp(fraction, 0.0, 1.0):0.##} 400");

    private static string Width(double fraction) => string.Create(Invariant, $"{fraction * 100:0.###}%");

    private static string Percent(double fraction, string format = "0") =>
        (fraction * 100).ToString(format, Invariant) + "%";

    private static string Dollars(decimal amount) => amount switch
    {
        >= 1_000_000m => "$" + (amount / 1_000_000m).ToString("0.##", Invariant) + "m",
        >= 1_000m => "$" + Math.Round(amount / 1_000m, MidpointRounding.AwayFromZero).ToString("0", Invariant) + "k",
        _ => "$" + Math.Round(amount).ToString("0", Invariant),
    };

    // A narrow segment keeps its colour but drops its words, which the bar's description and the figures beneath carry.
    private static RenderFragment SegmentLabel(string name, double fraction) => builder =>
    {
        if (fraction < 0.07)
        {
            return;
        }
        builder.OpenElement(0, "b");
        builder.AddContent(1, name);
        builder.CloseElement();
        builder.AddContent(2, Percent(fraction));
    };
}
