@* The status bar: the score (the Sharpe ratio: return for each unit of risk taken) first and largest, then the figures
   behind it.  It sits under the top bar of every signed-in page that has investments to score, scoped to what the page
   shows (all of a person's investments, or one account), and moves as prices do.  Its figures update quietly: they change
   with every tick of every holding, so flashing them would keep the bar lit; the tick itself flashes on the holding's price. *@
<section class="ta-status-bar" aria-label="@($"Score: {Scope}")">
    <div class="ta-score">
        <div class="ta-score-label">Sharpe ratio</div>
        <div class="ta-score-value">@Number(Performance?.SharpeRatio)</div>
        <div class="ta-score-scope">@Scope</div>
    </div>
    <dl class="ta-status-figures">
        <div><dt>Return</dt><dd>@Percent(Performance?.TotalReturn)</dd></div>
        <div><dt>Volatility</dt><dd>@Percent(Performance?.Volatility)</dd></div>
        <div><dt>Worth</dt><dd>@Money(Worth)</dd></div>
        <div><dt>Put in</dt><dd>@Money(PutIn)</dd></div>
        <div><dt>Gain</dt><dd>@Money(Gain)</dd></div>
    </dl>
</section>

@code {
    private static readonly System.Globalization.CultureInfo English = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    /// <summary>What is scored: "All investments", or an account's name.</summary>
    [Parameter, EditorRequired] public string Scope { get; set; } = "";

    /// <summary>The ledger's measure of the returns; null where there is none (several accounts together, for now).</summary>
    [Parameter] public PerformanceView? Performance { get; set; }

    [Parameter] public decimal? Worth { get; set; }

    [Parameter] public decimal PutIn { get; set; }

    [Parameter] public decimal? Gain { get; set; }

    private static string Money(decimal? value) => value is { } number ? number.ToString("C0", English) : "—";

    private static string Percent(decimal? value) => value is { } number ? number.ToString("P2", English) : "—";

    private static string Number(decimal? value) => value is { } number ? number.ToString("0.00", English) : "—";
}
