<CascadingValue Value="contents" IsFixed="true">
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <div class="ta-container ta-page">
                    <h1 class="ta-page-title">Please sign in</h1>
                    <p class="ta-lead"><a href="/account/signin" data-enhance-nav="false">Sign in</a> to see this page.</p>
                </div>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="ta-container ta-page">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </div>
        </LayoutView>
    </NotFound>
</Router>
</CascadingValue>

@code {
    private ContentsViewChoice contents = new();

    /// <summary>
    /// Tiles or details for an account's holdings: the person's choice, from its cookie, read when the site is opened.  The
    /// pages share one choice while the site is open (a page that changes it changes it for the next), so the cascaded
    /// object is fixed and its value changes in place.
    /// </summary>
    [Parameter] public ContentsView ContentsView { get; set; }

    protected override void OnInitialized() => contents = new() { View = ContentsView };
}
