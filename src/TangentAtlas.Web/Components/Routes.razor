<CascadingValue Value="ContentsView" IsFixed="true">
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <div class="ta-container ta-page">
                    <h1 class="ta-page-title">Please sign in</h1>
                    <p class="ta-lead"><a href="/account/signin" data-enhance-nav="false">Sign in</a> to see this page.</p>
                </div>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="ta-container ta-page">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </div>
        </LayoutView>
    </NotFound>
</Router>
</CascadingValue>

@code {
    /// <summary>
    /// Tiles or details for an account's holdings: the person's choice, from its cookie, read when the page loads.  A new
    /// choice goes through /contents-view, which sets the cookie and loads the page again, so the value never changes here.
    /// </summary>
    [Parameter] public ContentsView ContentsView { get; set; }
}
