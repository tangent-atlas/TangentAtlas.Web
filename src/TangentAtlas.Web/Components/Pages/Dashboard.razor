@page "/dashboard"
@attribute [Authorize]
@layout TangentAtlas.Web.Components.Layout.AppLayout
@inherits LedgerPage
@* The signed-in home: the score of the person's investments (the status bar), their accounts by group, and each
   investment account's figures. *@
<PageTitle>Dashboard · Tangent Atlas</PageTitle>
<SectionContent SectionName="app-title">Dashboard</SectionContent>

@{ var allInvestments = LedgerAccounts.In(AccountGroups.All[1]); }
@if (allInvestments.Count > 0)
{
    <SectionContent SectionName="status-bar"><StatusBar Scope="All investments" Performance="AccountGroups.PerformanceOf(allInvestments)" Worth="allInvestments.Sum(account => account.MarketValue ?? 0m)" PutIn="allInvestments.Sum(account => account.NetContributions)" Gain="allInvestments.Sum(account => account.Gain ?? 0m)" /></SectionContent>
}

<div class="ta-dashboard">
    <section class="ta-card" aria-labelledby="accounts-heading">
        <h2 id="accounts-heading" class="ta-card-title">Accounts</h2>
        <p class="ta-card-sub">@(LedgerAccounts.Count == 0 ? "Linking accounts is the next step to open." : Updated)</p>
        <div class="ta-groups-total"><span>All accounts</span><span>@Money(LedgerAccounts.Sum(AccountGroups.Contribution), 2)</span></div>
        @foreach (var group in AccountGroups.All)
        {
            var accounts = LedgerAccounts.In(group);
            <details class="ta-group" open="@(accounts.Count > 0)">
                <summary>
                    <span><span class="ta-group-name">@group.Name</span><span class="ta-group-kinds">@group.Kinds</span></span>
                    <span>@(accounts.Count > 0 ? Money(accounts.Sum(account => account.MarketValue ?? 0m) * (group.IsDebt ? -1 : 1), 2) : "")</span>
                </summary>
                <div class="ta-group-accounts">
                    @foreach (var account in accounts)
                    {
                        <a @key="account.AccountId" class="ta-group-account" href="@($"accounts/{account.AccountId}")"><span>@account.Name</span><span>@Money(account.MarketValue, 2)</span></a>
                    }
                    @if (accounts.Count == 0)
                    {
                        <div class="ta-group-empty">Linking: coming soon</div>
                    }
                    else if (group.Page is { } groupPage)
                    {
                        <a class="ta-group-all" href="@groupPage">All @group.Name.ToLowerInvariant() →</a>
                    }
                </div>
            </details>
        }
    </section>

    <div class="ta-dashboard-main">
        <h2 class="ta-greeting">Hello, @FirstName!</h2>

        @if (LedgerProblem is not null)
        {
            <div class="ta-status" role="status"><span class="ta-chip ta-chip-warning">Ledger</span><span>@LedgerProblem</span></div>
        }

        @if (LedgerAccounts.In(AccountGroups.All[1]) is { Count: > 0 } investments)
        {
            <section class="ta-card" aria-labelledby="investments-heading">
                <h2 id="investments-heading" class="ta-card-title"><a href="investments">Investments</a></h2>
                <p class="ta-card-sub">Measured at each close, deposits taken out.</p>
                <table class="ta-account-rows">
                    <thead><tr><th scope="col">Account</th><th scope="col">Worth</th><th scope="col">Return</th><th scope="col" class="ta-optional">Volatility</th><th scope="col">Sharpe</th></tr></thead>
                    <tbody>
                        @foreach (var account in investments)
                        {
                            <tr @key="account.AccountId">
                                <td><a href="@($"accounts/{account.AccountId}")">@account.Name</a></td>
                                <td>@Money(account.MarketValue)</td>
                                <td>@Percent(account.Performance?.TotalReturn)</td>
                                <td class="ta-optional">@Percent(account.Performance?.Volatility)</td>
                                <td>@Number(account.Performance?.SharpeRatio)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

    </div>
</div>

@code {
    private string FirstName => (Person?.DisplayName ?? "").Split([' ', '@'], StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
}
