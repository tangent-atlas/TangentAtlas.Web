@page "/dashboard"
@attribute [Authorize]
@layout TangentAtlas.Web.Components.Layout.AppLayout
@inherits LedgerPage
@* The signed-in home: the household's tree of portfolios on the left (the household itself is never shown; a name opens
   its page; only the first level shows until a portfolio is expanded, and this browser remembers what was expanded), and
   a card for each portfolio the person has starred on the right, in the layout of Ken's portfolios on Your plan. *@
<PageTitle>Dashboard · Tangent Atlas</PageTitle>
<SectionContent SectionName="app-title">Dashboard</SectionContent>

@{ var portfolios = Ledger?.Portfolios ?? []; var unfiled = Ledger?.Unfiled ?? []; var favorites = Ledger?.Favorites ?? []; }
<div class="ta-dashboard">
    <section class="ta-card" aria-labelledby="portfolios-heading">
        <div class="ta-pane-head">
            <h2 id="portfolios-heading" class="ta-card-title">Portfolios</h2>
            @if (portfolios.Count > 0)
            {
                <a class="ta-btn ta-btn-small ta-btn-outline" href="portfolios/new">+ New portfolio</a>
            }
        </div>
        <p class="ta-card-sub">@(LedgerAccounts.Count == 0 ? "Linking accounts is the next step to open." : Updated)</p>
        <div class="ta-tree">
            @foreach (var portfolio in portfolios)
            {
                @Branch(portfolio)
            }
            @if (unfiled.Count > 0)
            {
                <details class="ta-group" open>
                    <summary><span class="ta-group-name">Not in a portfolio</span><span></span></summary>
                    <div class="ta-group-accounts">
                        @foreach (var account in unfiled)
                        {
                            @AccountRow(account)
                        }
                    </div>
                </details>
            }
        </div>
    </section>

    <div class="ta-dashboard-main">
        @if (LedgerProblem is not null)
        {
            <div class="ta-status" role="status"><span class="ta-chip ta-chip-warning">Ledger</span><span>@LedgerProblem</span></div>
        }

        @foreach (var portfolio in favorites)
        {
            <section @key="portfolio.PortfolioId" class="ta-card ta-portfolio-card" aria-label="@portfolio.Name">
                <PortfolioCard Portfolio="portfolio" Link="true" />
            </section>
        }
        @if (favorites.Count == 0 && portfolios.Count > 0)
        {
            <section class="ta-card">
                <p class="ta-card-sub">Your starred portfolios show here. Open a portfolio in the tree to see it in full.</p>
            </section>
        }
    </div>
</div>

@code {
    /// <summary>
    /// A portfolio in the tree: its name and value, then, when expanded, its portfolios and its accounts.  Closed at first;
    /// the site's tree script reopens what this browser had expanded (the open attribute is the browser's, so a re-render
    /// doesn't close it).
    /// </summary>
    private RenderFragment Branch(PortfolioView portfolio) =>
        @<details @key="portfolio.PortfolioId" class="ta-group ta-tree-portfolio" data-tree-id="@portfolio.PortfolioId">
            <summary>
                <span class="ta-tree-name">
                    @if (portfolio.IsFavorite)
                    {
                        <span class="ta-star" title="Starred: on your dashboard" aria-label="Starred">★</span>
                    }
                    <a class="ta-group-name" href="@($"portfolios/{portfolio.PortfolioId}")">@portfolio.Name</a>
                </span>
                <span>@Money(portfolio.MarketValue, 2)</span>
            </summary>
            <div class="ta-group-accounts">
                @foreach (var child in portfolio.Portfolios)
                {
                    @Branch(child)
                }
                @foreach (var account in portfolio.Accounts)
                {
                    @AccountRow(account)
                }
                @if (portfolio.Portfolios.Count == 0 && portfolio.Accounts.Count == 0)
                {
                    <div class="ta-group-empty">Empty</div>
                }
            </div>
        </details>;

    /// <summary>
    /// An account in the tree, as banks list them: its name and the last four of its number ("Checking ••4821"), in
    /// lighter type than a portfolio; its institution on hover.
    /// </summary>
    private RenderFragment AccountRow(AccountView account) =>
        @<a @key="account.AccountId" class="ta-group-account ta-tree-account" href="@($"accounts/{account.AccountId}")" title="@account.Institution">
            <span>@account.Name@(account.Number is { } number ? $" {number}" : "")</span>
            <span>@Money(account.MarketValue, 2)</span>
        </a>;
}
