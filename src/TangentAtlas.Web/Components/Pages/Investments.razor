@page "/investments"
@attribute [Authorize]
@layout TangentAtlas.Web.Components.Layout.AppLayout
@inherits LedgerPage
@* Every investment account, totalled. *@
<PageTitle>Investments · Tangent Atlas</PageTitle>
<SectionContent SectionName="app-title">Investments</SectionContent>

@{ var accounts = LedgerAccounts.In(AccountGroups.All[1]); }

@if (LedgerProblem is not null)
{
    <div class="ta-status" role="status"><span class="ta-chip ta-chip-warning">Ledger</span><span>@LedgerProblem</span></div>
}

<SectionContent SectionName="status-bar"><StatusBar Scope="All investments" Performance="AccountGroups.PerformanceOf(accounts)" Worth="accounts.Sum(account => account.MarketValue ?? 0m)" PutIn="accounts.Sum(account => account.NetContributions)" Gain="accounts.Sum(account => account.Gain ?? 0m)" /></SectionContent>

<div class="ta-dashboard-main">

    <section class="ta-card" aria-labelledby="investment-accounts">
        <h2 id="investment-accounts" class="ta-card-title">Accounts</h2>
        <p class="ta-card-sub">Brokerage, 401(k), IRA & more. @Updated</p>
        @if (accounts.Count == 0)
        {
            <p>No investment accounts yet. Linking your own is the next step to open.</p>
        }
        else
        {
            <table class="ta-account-rows">
                <thead>
                    <tr><th scope="col">Account</th><th scope="col">Worth</th><th scope="col" class="ta-optional">Gain</th><th scope="col">Return</th><th scope="col" class="ta-optional">Volatility</th><th scope="col">Sharpe</th></tr>
                </thead>
                <tbody>
                    @foreach (var account in accounts)
                    {
                        <tr @key="account.AccountId">
                            <td>
                                <a href="@($"accounts/{account.AccountId}")">@account.Name</a>
                                <span class="ta-account-where">@account.Institution@(account.Number is { } number ? $" · {number}" : "")</span>
                            </td>
                            <td>@Money(account.MarketValue)</td>
                            <td class="ta-optional">@Money(account.Gain)</td>
                            <td>@Percent(account.Performance?.TotalReturn)</td>
                            <td class="ta-optional">@Percent(account.Performance?.Volatility)</td>
                            <td>@Number(account.Performance?.SharpeRatio)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>
