@page "/accounts/{AccountId:guid}"
@attribute [Authorize]
@inherits TangentAtlas.Web.Ledger.LedgerPage
@using TangentAtlas.Web.Ledger
<PageTitle>@(Account?.Name ?? "Account") · Tangent Atlas</PageTitle>

<div class="ta-container ta-page">
    <a class="ta-back" href="accounts">← My accounts</a>

    @if (LedgerProblem is not null)
    {
        <div class="ta-status" role="status"><span class="ta-chip ta-chip-warning">Ledger</span><span>@LedgerProblem</span></div>
    }
    else if (Account is not { } account)
    {
        <h1 class="ta-page-title">Not one of your accounts</h1>
        <p class="ta-lead">This account isn't among the accounts you can see.</p>
    }
    else
    {
        <div class="ta-eyebrow">@account.Institution@(account.Number is { } number ? $" · {number}" : "")</div>
        <h1 class="ta-page-title">@account.Name @if (account.IsPaper) { <span class="ta-chip">Paper money</span> }</h1>
        @if (account.ModelName is { } model)
        {
            <p class="ta-paper-note">Invested by the @model model@(account.IsPaper ? ": it rebalances at 3:45 pm New York time on market days and fills at the close" : "").</p>
        }

        <section class="ta-app-section ta-paper" aria-label="Performance">
            <div class="ta-net">
                <div class="ta-net-group">
                    <div><div class="ta-net-label">Worth</div><div class="ta-net-value ta-net-value-accent">@Money(account.MarketValue)</div></div>
                    <div><div class="ta-net-label">Put in</div><div class="ta-net-value">@Money(account.NetContributions)</div></div>
                    <div><div class="ta-net-label">Gain</div><div class="ta-net-value">@Money(account.Gain)</div></div>
                </div>
                <div class="ta-net-group ta-net-group-end">
                    <div><div class="ta-net-label">Return</div><div class="ta-net-value">@Percent(account.Performance?.TotalReturn)</div></div>
                    <div><div class="ta-net-label">Volatility</div><div class="ta-net-value">@Percent(account.Performance?.Volatility)</div></div>
                    <div><div class="ta-net-label">Sharpe ratio</div><div class="ta-net-value">@Number(account.Performance?.SharpeRatio)</div></div>
                </div>
            </div>
            <p class="ta-paper-note">
                @if (account.Performance is { From: { } from, Through: { } through, Returns: > 0 } performance)
                {
                    <span>Measured at each close from @from.ToString("MMMM d", English) to @through.ToString("MMMM d, yyyy", English): @performance.Returns daily return@(performance.Returns == 1 ? "" : "s"), worst drop @Percent(performance.MaximumDrawdown)@(performance.IsRanked ? "." : "; ranked after 20.")</span>
                }
                else
                {
                    <span>Its returns start with the next close.</span>
                }
                <span>@(" " + Updated)</span>
            </p>

            @if (Chart(account.Days) is { } chart)
            {
                <svg class="ta-paper-chart" viewBox="0 0 600 120" preserveAspectRatio="none" role="img" aria-label="@chart.Label">
                    <polyline points="@chart.Points" fill="none" stroke="var(--ta-green-dark)" stroke-width="2" vector-effect="non-scaling-stroke"></polyline>
                </svg>
            }
        </section>

        <section class="ta-app-section" aria-labelledby="holdings-heading">
            <h2 id="holdings-heading" class="ta-section-title">Holdings</h2>
            <table class="ta-paper-holdings">
                <thead>
                    <tr><th scope="col">Holding</th><th scope="col">Shares</th><th scope="col">Price</th><th scope="col">Value</th><th scope="col">Weight</th><th scope="col">Target</th></tr>
                </thead>
                <tbody>
                    @foreach (var holding in account.Holdings)
                    {
                        <tr>
                            <th scope="row">@holding.Name</th>
                            <td>@(holding.IsCash ? "" : holding.Quantity.ToString("N0", English))</td>
                            <td>@(holding.IsCash ? "" : Money(holding.Price, 2))</td>
                            <td>@Money(holding.MarketValue, 2)</td>
                            <td>@Percent(holding.Weight)</td>
                            <td>@Percent(holding.TargetWeight)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
</div>

@code {
    [Parameter] public Guid AccountId { get; set; }

    private AccountView? Account => LedgerAccounts.FirstOrDefault(account => account.AccountId == AccountId);
}
