@page "/accounts/{AccountId:guid}"
@attribute [Authorize]
@layout TangentAtlas.Web.Components.Layout.AppLayout
@inherits LedgerPage
<PageTitle>@(Account?.Name ?? "Account") · Tangent Atlas</PageTitle>
<SectionContent SectionName="app-title">
    <a class="ta-back" href="@(Account is { } shown && AccountGroups.All.FirstOrDefault(group => group.Types.Contains(shown.Type))?.Page is { } page ? page : "dashboard")">@(Account is { } here ? AccountGroups.All.FirstOrDefault(group => group.Types.Contains(here.Type))?.Name ?? "Dashboard" : "Dashboard")</a>
    <span class="ta-crumb">›</span> @(Account?.Name ?? "Account")
</SectionContent>

<LiveAccount @rendermode="InteractiveServer" AccountId="AccountId" View="View" />

@code {
    [Parameter] public Guid AccountId { get; set; }

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // The title and the way back: from the same live ledger, read once (the page around the live part is static).
    private AccountView? Account => LedgerAccounts.FirstOrDefault(account => account.AccountId == AccountId);

    private ContentsView View => ContentsViews.From(HttpContext);
}
