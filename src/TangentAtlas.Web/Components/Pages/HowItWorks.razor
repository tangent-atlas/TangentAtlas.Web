@page "/how-it-works"
<PageTitle>How it works · Tangent Atlas</PageTitle>

<div class="ta-container ta-page">
    <h1 class="ta-visually-hidden">How it works</h1>   @* The menu already names the page; the heading is kept for screen readers and search. *@
    <p class="ta-page-idea">Up and running in three steps.</p>
    <ol class="ta-steps">
        <li class="ta-step">
            <div class="ta-step-num">1</div>
            <div class="ta-step-title">Link</div>
            <div class="ta-step-body">Link your accounts. We never see your passwords.</div>
        </li>
        <li class="ta-step">
            <div class="ta-step-num">2</div>
            <div class="ta-step-title">Set</div>
            <div class="ta-step-body">Set your rules, like setting a thermostat.</div>
        </li>
        <li class="ta-step">
            <div class="ta-step-num">3</div>
            <div class="ta-step-title">Relax</div>
            <div class="ta-step-body">Atlas keeps every account the way you set it, in calm markets and rough ones.</div>
        </li>
    </ol>
</div>
