@page "/your-net-worth"
<PageTitle>Your net worth · Tangent Atlas</PageTitle>

<div class="ta-container ta-page">
    <h1 class="ta-page-headline">Your net worth</h1>
    <p class="ta-page-sub">Every account, every rule, one screen.</p>

    <div class="ta-net">
        <div class="ta-net-group">
            <div><div class="ta-net-label">You own</div><div class="ta-net-value">$411,120</div></div>
            <div><div class="ta-net-label">You owe</div><div class="ta-net-value">$3,850</div></div>
            <div><div class="ta-net-label">Net worth</div><div class="ta-net-value ta-net-value-accent">$407,270</div></div>
        </div>
        @* The example's last 12 months (October 2025 to October 2026): its stocks followed the market, its savings earned Treasury-bill interest. *@
        <div class="ta-net-group ta-net-group-end">
            <div><div class="ta-net-label">12-month return</div><div class="ta-net-value">13.6%</div></div>
            <div><div class="ta-net-label">Volatility</div><div class="ta-net-value">11.9%</div></div>
            <div><div class="ta-net-label">Sharpe ratio</div><div class="ta-net-value">0.83</div></div>
        </div>
    </div>

    <div class="ta-net-divider">6 accounts at 4 institutions · every rule on track</div>

    <div class="ta-accounts">
        @foreach (var account in ExampleAccounts)
        {
            <div class="ta-account">
                <div class="ta-account-head"><span class="ta-account-name">@account.Name</span><span class="ta-account-where">@account.Where</span></div>
                <div class="ta-account-value">@account.Balance</div>
                <div class="ta-account-status @(account.ReadOnly ? "ta-account-status-neutral" : "")">@account.Status</div>
            </div>
        }
    </div>

    <div class="ta-page-final">
        <p class="ta-page-close">Finally, the whole picture.</p>
        <AuthorizeView>
            <NotAuthorized>
                <a href="/signup" class="ta-btn ta-btn-primary ta-btn-large">Sign up</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private static readonly (string Name, string Where, string Balance, string Status, bool ReadOnly)[] ExampleAccounts =
    [
        ("Checking", "Bank of America", "$7,420", "Inside your $5k–$10k band", false),
        ("Savings", "Bank of America", "$24,000", "Topped up this month", false),
        ("Brokerage", "Schwab", "$186,500", "On your model", false),
        ("IRA", "Schwab", "$98,200", "Maxed for the year", false),
        ("Credit card", "American Express", "$3,850", "Paid in full on the 14th", false),
        ("401(k)", "Fidelity", "$95,000", "Counted, never traded", true),
    ];
}
