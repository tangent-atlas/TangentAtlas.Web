@page "/your-net-worth"
<PageTitle>Your net worth · Tangent Atlas</PageTitle>

<div class="ta-container ta-page">
    <h1 class="ta-page-headline">Your net worth</h1>
    <p class="ta-page-sub">Every account, every rule, one screen.</p>
    <p class="ta-page-sub">Meet Ken. He’s 46, and he’s had three employers in 26 years. Along the way he collected a checking account, savings at two other banks, a brokerage account, a Roth IRA, a 401(k) and two credit cards. Here is Ken’s dashboard in Tangent Atlas.</p>

    <div class="ta-net">
        <div class="ta-net-group">
            <div><div class="ta-net-label">You own</div><div class="ta-net-value">$505,090</div></div>
            <div><div class="ta-net-label">You owe</div><div class="ta-net-value">$5,090</div></div>
            <div><div class="ta-net-label">Net worth</div><div class="ta-net-value ta-net-value-accent">$500,000</div></div>
        </div>
        @* The same figures as "Ken today" on "Have a plan": his mix over five years, October 2021 to October 2026, cash earning nothing. *@
        <div class="ta-net-group ta-net-group-end">
            <div><div class="ta-net-label">Annual return</div><div class="ta-net-value">10.4%</div></div>
            <div><div class="ta-net-label">Volatility</div><div class="ta-net-value">15.5%</div></div>
            <div><div class="ta-net-label">Sharpe ratio</div><div class="ta-net-value">0.48</div></div>
        </div>
    </div>

    <div class="ta-status-bar">
        <span class="ta-chip"><b>8</b> accounts</span>
        <span class="ta-chip"><b>6</b> rules</span>
        <span class="ta-chip ta-chip-warning"><b>2</b> warnings</span>
        <span class="ta-chip ta-chip-quiet"><b>0</b> errors</span>
        <span class="ta-status-approval"><span><b>3 trades</b> waiting for your approval</span> <span class="ta-btn ta-btn-primary ta-btn-small">Review</span></span>
    </div>

    <div class="ta-accounts">
        @foreach (var account in ExampleAccounts)
        {
            <div class="ta-account">
                <div class="ta-account-head">
                    <span class="ta-account-name">
                        @account.Name
                        @if (account.State == Warning)
                        {
                            <svg class="ta-warning" width="16" height="16" viewBox="0 0 16 16" role="img" aria-label="Warning"><path d="M8 1.5 15 14.5H1z" fill="#E8A317" stroke="#E8A317" stroke-width="1.5" stroke-linejoin="round"></path><rect x="7.2" y="5.5" width="1.6" height="5" rx="0.8" fill="#ffffff"></rect><circle cx="8" cy="12.3" r="0.95" fill="#ffffff"></circle></svg>
                        }
                    </span>
                    <span class="ta-account-where">@account.Where</span>
                </div>
                <div class="ta-account-value">@account.Balance</div>
                @if (account.Holdings is not null)
                {
                    <div class="ta-account-holdings">@account.Holdings</div>
                }
                <div class="ta-account-status @StatusClass(account.State)">@account.Status</div>
            </div>
        }
    </div>

    <div class="ta-page-final">
        <p class="ta-page-close">Finally, the whole picture.</p>
        <AuthorizeView>
            <NotAuthorized>
                <a href="/signup" class="ta-btn ta-btn-primary ta-btn-large">Sign up</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    // Ken: eight accounts and six rules (the old Chase savings has none; the 401(k) is counted, never traded); two rules are warning, none in error.
    // His net worth is "Ken today" on "Have a plan", $500,000: JPM $60k, DIS $40k, SPY $200k (Roth IRA, plus the S&P 500 fund in his 401(k)),
    // QQQ $120k, and cash $80k net of the $5,090 on his cards ($85,090 in checking, savings and the brokerage account).
    private const string OnTrack = "on-track", Warning = "warning", ReadOnly = "read-only";

    private static readonly (string Name, string Where, string Balance, string Status, string State, string? Holdings)[] ExampleAccounts =
    [
        ("Checking", "Bank of America", "$4,180", "Below your $5k–$10k band", Warning, null),
        ("Savings", "Ally", "$45,000", "Topped up this month", OnTrack, null),
        ("Savings", "Chase", "$17,090", "No rule yet", ReadOnly, null),
        ("Brokerage", "Schwab", "$238,820", "Drifted from your model", Warning, "JPM $60k · DIS $40k · QQQ $120k · cash $18.8k"),
        ("Roth IRA", "Schwab", "$105,000", "Maxed for the year", OnTrack, "SPY $105k"),
        ("Credit card", "American Express", "$3,850", "Paid in full on the 14th", OnTrack, null),
        ("Credit card", "Discover", "$1,240", "Set to pay in full on the 21st", OnTrack, null),
        ("401(k)", "Fidelity", "$95,000", "Counted, never traded", ReadOnly, "S&P 500 fund $95k"),
    ];

    private static string StatusClass(string state) => state switch
    {
        Warning => "ta-account-status-warning",
        ReadOnly => "ta-account-status-neutral",
        _ => "",
    };
}
