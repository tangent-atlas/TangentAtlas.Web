@page "/your-net-worth"
<PageTitle>Your net worth · Tangent Atlas</PageTitle>

<div class="ta-container ta-page">
    <h1 class="ta-page-headline">Your net worth</h1>
    <p class="ta-page-sub">Every account, every rule, one screen.</p>

    <div class="ta-net">
        <div><div class="ta-net-label">You own</div><div class="ta-net-value">$411,120</div></div>
        <div><div class="ta-net-label">You owe</div><div class="ta-net-value">$3,850</div></div>
        <div><div class="ta-net-label">Net worth</div><div class="ta-net-value ta-net-value-accent">$407,270</div></div>
        <div class="ta-net-note">6 accounts at 3 institutions · every rule on track</div>
    </div>

    <div class="ta-accounts">
        @foreach (var account in ExampleAccounts)
        {
            <div class="ta-account">
                <div class="ta-account-head"><span class="ta-account-name">@account.Name</span><span class="ta-account-where">@account.Where</span></div>
                <div class="ta-account-value">@account.Balance</div>
                <div class="ta-account-status @(account.ReadOnly ? "ta-account-status-neutral" : "")">@account.Status</div>
            </div>
        }
    </div>
    <p class="ta-caption">An example. Your accounts stay at your own bank, broker and card issuer.</p>
</div>

@code {
    private static readonly (string Name, string Where, string Balance, string Status, bool ReadOnly)[] ExampleAccounts =
    [
        ("Checking", "Your bank", "$7,420", "Inside your $5k–$10k band", false),
        ("Savings", "Your bank", "$24,000", "Topped up this month", false),
        ("Brokerage", "Your broker", "$186,500", "On your model", false),
        ("IRA", "Your broker", "$98,200", "Maxed for the year", false),
        ("Credit card", "Your card issuer", "$3,850", "Paid in full on the 14th", false),
        ("401(k)", "Your employer's plan", "$95,000", "Counted, never traded", true),
    ];
}
