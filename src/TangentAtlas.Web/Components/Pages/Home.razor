    <div class="ta-footer-links">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="https://github.com/AtlasLedger" target="_blank">Atlas Ledger</a>
        <a href="/contact">Contact</a>
    </div>
</footer>
