@page "/accounts"
@attribute [Authorize]
@using System.Globalization
@using TangentAtlas.Web.Dashboard
@using TangentAtlas.Web.Illustration
<PageTitle>Dashboard · Tangent Atlas</PageTitle>

@* The signed-in dashboard (prototype, November 7). The shell is the familiar dashboard of cards; each card reads like a
   thermostat: what it is set to, what it reads now, what it is doing about it. The order is the plan's own: what needs
   you, then the index, then the rules that feed it, then the accounts. Until accounts can be linked it shows Ken. *@
<div class="ta-container ta-page ta-dash">
    <header class="ta-dash-head">
        <div>
            <h1 class="ta-dash-title">Welcome, @person?.DisplayName</h1>
            <div class="ta-dash-net">
                <span>You own <b>@Money(Model.Own)</b></span>
                <span>You owe <b>@Money(Model.Owe)</b></span>
                <span>Net worth <b>@Money(Model.NetWorth)</b></span>
            </div>
        </div>
    </header>

    <div class="ta-status" role="status">
        <span class="ta-chip">Sample</span>
        <span>This is Ken’s dashboard, our example customer. Linking accounts is the next step to open. Then you’ll see your own. We'll let you know when it does@(person?.Email is { } email ? $", at {email}" : "").</span>
    </div>

    @if (Model.NeedsYou.Count > 0)
    {
        <section class="ta-dash-section" aria-labelledby="needs-you-heading">
            <h2 id="needs-you-heading" class="ta-dash-section-title">Needs you</h2>
            <ul class="ta-needs">
                @foreach (var item in Model.NeedsYou)
                {
                    <li class="ta-need ta-state-@State(item.State)">
                        <span class="ta-need-text">
                            <span class="ta-need-what">@item.What</span>
                            <span class="ta-need-why">@item.Why</span>
                        </span>
                        <button type="button" class="ta-btn ta-btn-primary ta-btn-small" disabled title="Prototype">@item.Action</button>
                    </li>
                }
            </ul>
        </section>
    }

    <section class="ta-dash-section" aria-labelledby="index-heading">
        <article class="ta-card ta-card-plan ta-state-@State(Model.Index.State)">
            <div class="ta-card-head">
                <h2 id="index-heading" class="ta-card-title">Your personal index</h2>
                <span class="ta-card-badge">@Badge(Model.Index.State)</span>
            </div>
            <p class="ta-card-where">@Model.Index.HeldIn · @Money(Model.Index.Value)</p>

            <dl class="ta-reading ta-reading-plan">
                <div><dt>Set to</dt><dd>@Model.Index.CompanyCount largest US companies, risk held at @Pct(Model.Index.TargetVolatilityPercent)</dd></div>
                <div><dt>Now</dt><dd>Risk @Pct(Model.Index.VolatilityNowPercent), over the last 21 trading days</dd></div>
                <div><dt>Doing</dt><dd>@Model.Index.Doing</dd></div>
            </dl>
            <p class="ta-card-note">Left out: @string.Join(", ", Model.Index.Exclusions)</p>

            <details class="ta-card-more">
                <summary>Turn the dials</summary>
                <IndexDials @rendermode="InteractiveServer" ShowHeading="false"
                            InitialCompanyCount="Model.Index.CompanyCount"
                            InitialRisk="RiskSetting.HoldSteady"
                            InitialTargetPercent="Model.Index.TargetVolatilityPercent"
                            InitialAccountValue="Model.Index.Value" />
            </details>
        </article>
    </section>

    <section class="ta-dash-section" aria-labelledby="rules-heading">
        <h2 id="rules-heading" class="ta-dash-section-title">Your rules</h2>
        <div class="ta-cards">
            @foreach (var rule in Model.Rules)
            {
                <article class="ta-card ta-state-@State(rule.State)">
                    <div class="ta-card-head">
                        <h3 class="ta-card-title">@rule.Title</h3>
                        <span class="ta-card-badge">@Badge(rule.State)</span>
                    </div>
                    <p class="ta-card-where">@rule.Accounts</p>
                    <dl class="ta-reading">
                        <div><dt>Set to</dt><dd>@rule.Reading.Set</dd></div>
                        <div><dt>Now</dt><dd>@rule.Reading.Now</dd></div>
                        <div><dt>Doing</dt><dd>@rule.Reading.Doing</dd></div>
                    </dl>
                </article>
            }
        </div>
    </section>

    <section class="ta-dash-section" aria-labelledby="accounts-heading">
        <h2 id="accounts-heading" class="ta-dash-section-title">Your accounts</h2>
        <div class="ta-cards">
            @foreach (var institution in Model.Institutions)
            {
                <article class="ta-card">
                    <h3 class="ta-card-title">@institution.Institution</h3>
                    <ul class="ta-lines">
                        @foreach (var account in institution.Accounts)
                        {
                            <li><span>@account.Name</span><span class="ta-line-value">@(account.IsOwed ? "−" : "")@Money(account.Balance)</span></li>
                        }
                    </ul>
                </article>
            }
            <article class="ta-card ta-card-add">
                <h3 class="ta-card-title">Link an account</h3>
                <p class="ta-card-where">Banks, brokerage, cards and 401(k). Read-only; you can turn it off at any time.</p>
                <button type="button" class="ta-btn ta-btn-outline ta-btn-small" disabled>Coming soon</button>
            </article>
        </div>
    </section>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private SignedInPerson? person;

    private static DashboardModel Model => SampleDashboard.Ken;

    private static readonly CultureInfo English = CultureInfo.GetCultureInfo("en-US");

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
        {
            person = SignedInPerson.From((await AuthenticationState).User);
        }
    }

    private static string Money(decimal amount) => amount.ToString("$#,0", English);

    private static string Pct(double percent) => percent.ToString("0.0", English) + "%";

    private static string State(CardState state) => state switch
    {
        CardState.Warning => "warning",
        CardState.Waiting => "waiting",
        _ => "ok",
    };

    private static string Badge(CardState state) => state switch
    {
        CardState.Warning => "Needs attention",
        CardState.Waiting => "Waiting",
        _ => "On target",
    };
}
