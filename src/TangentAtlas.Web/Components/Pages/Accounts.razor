@page "/accounts"
@attribute [Authorize]
@inherits TangentAtlas.Web.Ledger.LedgerPage
@using TangentAtlas.Web.Ledger
<PageTitle>My accounts · Tangent Atlas</PageTitle>

<div class="ta-container ta-page">
    <div class="ta-eyebrow">Your money</div>
    <h1 class="ta-page-title">Welcome, @Person?.DisplayName</h1>

    <div class="ta-status" role="status">
        <span class="ta-chip">Beta</span>
        @if (LedgerAccounts.Any(account => account.IsPaper))
        {
            <span>Your paper brokerage account is live: paper money, invested by your model at each day's close. Linking your own accounts is the next step to open.</span>
        }
        else
        {
            <span>Linking accounts is the next step to open. We'll let you know when it does@(Person?.Email is { } email ? $", at {email}" : "").</span>
        }
    </div>

    @if (LedgerProblem is not null)
    {
        <div class="ta-status" role="status"><span class="ta-chip ta-chip-warning">Ledger</span><span>@LedgerProblem</span></div>
    }

    <section class="ta-app-section" aria-labelledby="summary-heading">
        <h2 id="summary-heading" class="ta-visually-hidden">Summary</h2>
        <div class="ta-tiles">
            @if (LedgerAccounts.Count > 0)
            {
                <div class="ta-tile">
                    <div class="ta-tile-label">What you own</div>
                    <div class="ta-tile-value">@Money(Owned)</div>
                    <div class="ta-tile-sub">@Counted(LedgerAccounts.Where(account => !IsDebt(account)))</div>
                </div>
                <div class="ta-tile">
                    <div class="ta-tile-label">What you owe</div>
                    <div class="ta-tile-value">@Money(Owed)</div>
                    <div class="ta-tile-sub">@(LedgerAccounts.Any(IsDebt) ? Counted(LedgerAccounts.Where(IsDebt)) : "No cards or loans linked")</div>
                </div>
                <div class="ta-tile">
                    <div class="ta-tile-label">Net</div>
                    <div class="ta-tile-value">@Money(Owned - Owed)</div>
                    <div class="ta-tile-sub">@Updated</div>
                </div>
            }
            else
            {
                <div class="ta-tile">
                    <div class="ta-tile-label">What you own</div>
                    <div class="ta-tile-value">—</div>
                    <div class="ta-tile-sub">Link an account to see this</div>
                </div>
                <div class="ta-tile">
                    <div class="ta-tile-label">What you owe</div>
                    <div class="ta-tile-value">—</div>
                    <div class="ta-tile-sub">Link an account to see this</div>
                </div>
                <div class="ta-tile">
                    <div class="ta-tile-label">Net</div>
                    <div class="ta-tile-value">—</div>
                    <div class="ta-tile-sub">Link an account to see this</div>
                </div>
            }
        </div>
    </section>

    <section class="ta-app-section" aria-labelledby="accounts-heading">
        <h2 id="accounts-heading" class="ta-section-title">Your accounts</h2>
        <div class="ta-kinds">
            @foreach (var kind in AccountKinds)
            {
                <div class="ta-kind">
                    <div class="ta-kind-title">@kind.Title</div>
                    @{ var accounts = LedgerAccounts.Where(account => account.Type == kind.Type).ToArray(); }
                    @if (accounts.Length == 0)
                    {
                        <div class="ta-kind-body">@kind.Body</div>
                    }
                    else
                    {
                        <div class="ta-kind-body">
                            @foreach (var account in accounts)
                            {
                                <a class="ta-kind-account" href="@($"accounts/{account.AccountId}")">
                                    <span class="ta-kind-account-name">@account.Name</span>
                                    <span class="ta-kind-account-value">@Money(account.MarketValue)</span>
                                    <span class="ta-kind-account-where">@account.Institution@(account.Number is { } number ? $" · {number}" : "")@(account.IsPaper ? " · paper money" : "")</span>
                                </a>
                            }
                        </div>
                    }
                    <button type="button" class="ta-btn ta-btn-outline" disabled>Link: coming soon</button>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private static readonly (string Title, string Type, string Body)[] AccountKinds =
    [
        ("Bank accounts", "Deposit", "Checking and savings, from your own bank."),
        ("Brokerage", "Brokerage", "Your investment accounts, with the stocks you already own."),
        ("Credit cards", "CreditCard", "Balances, statement amounts and due dates."),
        ("401(k)", "RetirementPlan", "Shown and counted in your picture. Your plan controls its trades and contributions."),
    ];

    private static bool IsDebt(AccountView account) => account.Type is "CreditCard" or "Loan";

    private decimal Owned => LedgerAccounts.Where(account => !IsDebt(account)).Sum(account => account.MarketValue ?? 0m);

    private decimal Owed => LedgerAccounts.Where(IsDebt).Sum(account => Math.Abs(account.MarketValue ?? 0m));

    private static string Counted(IEnumerable<AccountView> accounts)
    {
        var list = accounts.ToArray();
        var paper = list.Count(account => account.IsPaper);
        return $"Across {list.Length} account{(list.Length == 1 ? "" : "s")}{(paper == list.Length && paper > 0 ? ", paper money" : paper > 0 ? $", {paper} of paper money" : "")}";
    }
}
